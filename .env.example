# Copy this file to .env.development.local for local development with
# `vercel dev`, or let Vercel inject it automatically in production once
# you've connected a Postgres database to your project (Storage tab ->
# Create Database -> Postgres). In production you do NOT need to set this
# manually — Vercel provisions it for you.
#
# Locally, after linking your project with `vercel link` and connecting a
# database, you can pull the real values with:
#   vercel env pull .env.development.local

POSTGRES_URL="postgres://username:password@host:5432/database?sslmode=require"
